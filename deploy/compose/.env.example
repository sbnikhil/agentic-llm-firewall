# Copy to .env (never commit it) and replace every value.
# Generate random values with, for example: openssl rand -hex 32

# LiteLLM admin key. Must start with "sk-".
LITELLM_MASTER_KEY=sk-replace-with-a-random-value

# Password for the compose Postgres (LiteLLM's virtual keys, users, teams).
POSTGRES_PASSWORD=replace-with-a-random-value

# Key for the HMAC-SHA256 of user ids in audit events. Required: the
# guardrail refuses to start without it. Keep it secret and stable; changing
# it changes every user's audit hash.
LLMFW_AUDIT_HMAC_KEY=replace-with-a-random-value

# Dev keys for alice (team-standard) and bob (team-strict). bootstrap
# creates them with these values and allowed_routes limited to the chat
# routes. Must start with "sk-".
LLMFW_DEV_ALICE_KEY=sk-replace-with-a-random-value
LLMFW_DEV_BOB_KEY=sk-replace-with-a-random-value

# Upstream model. Default: the mock upstream in this stack.
# UPSTREAM_MODEL=openai/mock
# UPSTREAM_API_BASE=http://mock-upstream:8000/v1
# UPSTREAM_API_KEY=not-needed
#
# Ollama instead (docker compose --profile ollama up):
# UPSTREAM_MODEL=ollama_chat/qwen2.5:0.5b
# UPSTREAM_API_BASE=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:0.5b

# Streaming window (ADR 0004). Defaults: 128 / 128 / 32.
# LLMFW_STREAM_HOLDBACK_CHARS=128
# LLMFW_STREAM_CONTEXT_CHARS=128
# LLMFW_STREAM_SCAN_STEP_CHARS=32
