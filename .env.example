# Copy to .env and fill in. Never commit .env.

# --- Gateway (app/) ---
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...
ASTRA_DB_KEYSPACE=default_keyspace
# Only needed if Cassandra checkpointing is re-enabled (app/graph/workflow.py)
ASTRA_DB_ID=

# --- Training pipeline (scripts/, training/) ---
AWS_REGION=us-east-1
S3_BUCKET=llm-firewall
SAGEMAKER_ROLE_ARN=arn:aws:iam::<account-id>:role/<sagemaker-execution-role>
WANDB_API_KEY=
WANDB_PROJECT=llm-firewall-injection-detection
